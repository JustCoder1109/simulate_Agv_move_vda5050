建立容器 ros2_agv_vda5050
# 1. 先开权限（必须）
xhost +local:docker

# 2. 再创建&运行容器
docker run -it \
    --name ros2_agv_vda5050 \
    --network=host \
    -e DISPLAY=$DISPLAY \
    -v /tmp/.X11-unix:/tmp/.X11-unix \
    -v $HOME/hzt_practise/simulate_Agv_move_vda5050/ros2_ws:/root/ros2_ws \ #用作ROS2的工作空间
    docker.m.daocloud.io/osrf/ros:humble-desktop-full

# 3. colcon build 工作空间，ros2_ws
# 4. colcon build pkg 功能包
# 5. 编写helloworld.py, 编写一个node节点

